    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run host",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "sbc-app/cmd/main.go",
            "cwd": "${workspaceFolder}/sbc-app",
            "console": "integratedTerminal",
            "env": {
                "UI_DEV": "${workspaceFolder}/sbc-app/pkg/net/impl/ui",
                "WEBGLUE_DEV": "${workspaceFolder}/../go-webglue/pkg/client",
                "LOG_LEVEL": "debug",
            },
        }
    ]
}